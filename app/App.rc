#include "resource.h"
#include "Version.h"
#include <winres.h>

IDI_MIDI_PICKUP ICON "Assets\\Elka.MidiPickup.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ELKA_VERSION_NUMBERS
 PRODUCTVERSION ELKA_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ElkaSoft"
            VALUE "FileDescription", "Elka MIDI Pickup - prerelease"
            VALUE "FileVersion", ELKA_VERSION_STRING
            VALUE "InternalName", "Elka.MidiPickup"
            VALUE "OriginalFilename", "Elka.MidiPickup.exe"
            VALUE "ProductName", "Elka MIDI Pickup"
            VALUE "ProductVersion", ELKA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
